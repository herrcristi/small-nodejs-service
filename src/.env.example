# env
NODE_ENV='dev'

# web
SMALL_API_PORT=8080

# config
SMALL_API_URL='http://localhost:8080' # app url 
SMALL_UI_URL='http://localhost:8081' # ui url: the links of the emails (set password, application)
SMALL_API_CORS_ORIGIN='http://localhost:8080,http://localhost:8081' # app url + ui url

SMALL_API_AUTH_PROVIDER_TYPE=local # for testing default is local (local / firebase)
# the secrets below are EXAMPLE values: accepted only in debug mode (NODE_ENV dev), refused in production
# generate each one; SMALL_API_S2SPASS must be different from the auth passwords
SMALL_API_SALT='bcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbcccbccc' # 64 chars <generate: openssl rand -hex 32>
SMALL_API_S2SPASS='00001111222233334444555566667777' # 32 characters <generate: openssl rand -hex 16>
SMALL_API_PREVAUTHPASS='00001111222233334444555566667777' # 32 characters, the previous auth password (rotation) <generate: openssl rand -hex 16>
SMALL_API_AUTHPASS='00001111222233334444555566667777' # 32 characters <generate: openssl rand -hex 16>

# proxies in front of the api: a number (1) or addresses ('loopback, 10.0.0.0/8'); empty: no proxy is trusted
SMALL_API_TRUST_PROXY=
# auth cookie SameSite: lax (default, the ui and the api on the same site) or none (on different sites, needs https)
SMALL_API_COOKIE_SAMESITE=lax
# rate limits per 15 minutes (optional): all requests of an address, failed logins of an account from an address,
# failed logins of an account, reset password emails of an account
# SMALL_API_RATE_LIMIT_MAX=1000
# SMALL_API_RATE_LIMIT_LOGIN_MAX=5
# SMALL_API_RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
# SMALL_API_RATE_LIMIT_RESET_MAX=3
# internal routes (/api/internal_v1): true only when the services run in separate processes
SMALL_API_INTERNAL_ROUTES=false

SMALL_API_SMTP_CONFIG='{ "host": "host", "port": "465", "user": "user", "password": "password", "from": "small@localhost" }' # { host, port, user, pass, from }


# database
SMALL_API_DATABASE_URL=${MONGODB_LOCAL_URL} # mongodb://${MONGODB_ROOT_USERNAME}:${MONGODB_ROOT_PASSWORD}@localhost/
SMALL_API_DATABASE_DB='Small-Test'
SMALL_API_DATABASE_LIMITS='connections=16;connwaitmax=30s;timeout=30s' # connections: the connections of each process to each member of the replica set (keep processes x connections under what the members accept); connwaitmax: how long a request waits for a free one; timeout: how long a database call may run (the server stops it). After a wait or a call that is too long the request answers 503. Times in seconds ('30s' or '30'), names in any order, separated by ';'. Optional, each one: 16 connections, 30s, 30s by default
SMALL_API_PORTAL_SCHOOL_ID='00000000-0000-4000-8000-000000000001' # UUID of the portal organization
SMALL_API_PORTAL_ADMIN_EMAIL='portal.admin@example.test' # email of the first portal admin: at startup, if the portal school has no portal admin yet, it is invited (a password setup email is sent). Optional, leave empty to skip
SMALL_API_PENDING_EXPIRES_IN=259200 # seconds a pending user (an invitation not used) or a pending school (a signup without a login) is kept before it is removed (checked every hour, or as often as this when it is shorter). Optional, 259200 (72 hours) by default
