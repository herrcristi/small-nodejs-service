{
  "name": "small-nodejs-service",
  "version": "1.0.0",
  "description": "Small Nodejs Service",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "up": "docker compose -f ../tools/local/docker-compose.yaml up -d",
    "down": "docker compose -f ../tools/local/docker-compose.yaml down",
    "test": "nyc --reporter=text --reporter=html mocha --require test/hooks.js --timeout 15000 --reporter mocha-multi-reporters --exit",
    "testdb": "IS_TEST_DB=1 nyc --reporter=text --reporter=html mocha --require test/hooks.js --timeout 15000 --reporter mocha-multi-reporters --exit"
  },
  "keywords": [
    "small",
    "nodejs",
    "micro",
    "service"
  ],
  "author": "Small",
  "license": "ISC",
  "dependencies": {
    "api-query-params": "6.1.0",
    "axios": "1.21.1",
    "body-parser": "2.4.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "joi": "18.3.2",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongodb": "7.9.0",
    "nodemailer": "10.6.0"
  },
  "devDependencies": {
    "axios-mock-adapter": "2.1.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "mocha-multi-reporters": "1.5.2",
    "nyc": "18.0.0",
    "query-string": "10.0.0",
    "sinon": "22.1.0",
    "supertest": "7.3.2"
  }
}
